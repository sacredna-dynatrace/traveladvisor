# deploy-eks.sh 용 환경 변수 템플릿
#   cp .env-eks.example .env-eks && chmod 600 .env-eks && nano .env-eks
#   source .env-eks && ./deploy-eks.sh
# ※ .env-eks 는 실제 키가 들어가므로 .gitignore 처리됨 — 절대 commit 하지 말 것

# ── AWS (배포용 IAM 사용자 프로파일: EKS/EC2/CloudFormation/IAM/ECR 권한 필요) ──
export AWS_PROFILE=eks-admin                 # [변경] aws configure --profile <이름> 으로 만든 프로파일
export AWS_REGION=ap-northeast-2
export CREATE_CLUSTER=false                  # 최초 1회만 true (클러스터 신규 생성)
export SKIP_BUILD=false                      # 이미 ECR에 이미지가 있으면 true + TAG 지정
# export TAG=<ECR에 있는 이미지 태그>

# ── Dynatrace ──
export DT_ENDPOINT=https://<tenant-id>.live.dynatrace.com     # [변경] apps. 가 아닌 live. 주소
export DT_OPERATOR_TOKEN=<OPERATOR_TOKEN>                      # [변경] Operator token
export DT_TOKEN=<DATA_INGEST_TOKEN>                            # [변경] Data Ingest token (Operator token과 별개)
export DT_RUM_SNIPPET='<script type="text/javascript" src="https://js-cdn.dynatrace.com/jstag/..." crossorigin="anonymous"></script>'  # [변경] Frontend JS tag 전체

# ── LLM ──
export LLM_PROVIDER=anthropic                # anthropic | bedrock
export ANTHROPIC_API_KEY=<ANTHROPIC_KEY>     # [변경] anthropic 사용 시

# bedrock 사용 시 (AWS_ACCESS_KEY_ID 이름을 쓰면 aws CLI가 AWS_PROFILE 대신 이 키를 쓰므로 이름 분리)
export BEDROCK_ACCESS_KEY_ID=<BEDROCK_ONLY_KEY>        # [변경] Bedrock 호출 권한만 가진 IAM 사용자 키
export BEDROCK_SECRET_ACCESS_KEY=<BEDROCK_ONLY_SECRET> # [변경]
export BEDROCK_REGION=us-east-1
# export AWS_MODEL=us.amazon.nova-2-lite-v1:0
# export AWS_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# LoadBalancer 접근 허용 IP (현재 PC 공인 IP)
export ALLOWED_CIDR=$(curl -s https://checkip.amazonaws.com)/32
